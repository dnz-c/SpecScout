{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 21, "patch": 0 },
  "configurePresets": [
    {
      "name": "vs2022",
      "displayName": "VS2022 x64 (vcpkg)",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "C:/vcpkg/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_TARGET_TRIPLET": "x64-windows",
        "SPECSCOUT_WITH_TRITON": "OFF"
      }
    },
    {
      "name": "vs2022-full",
      "inherits": "vs2022",
      "displayName": "VS2022 x64 (vcpkg, +Triton)",
      "cacheVariables": { "SPECSCOUT_WITH_TRITON": "ON" }
    }
  ],
  "buildPresets": [
    { "name": "vs2022",      "configurePreset": "vs2022",      "configuration": "Release" },
    { "name": "vs2022-full", "configurePreset": "vs2022-full", "configuration": "Release" }
  ]
}
